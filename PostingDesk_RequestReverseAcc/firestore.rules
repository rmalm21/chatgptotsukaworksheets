rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(workspace) {
      return /databases/$(database)/documents/workspaces/$(workspace)/members/$(request.auth.uid);
    }
    function requestPath(workspace, id) {
      return /databases/$(database)/documents/workspaces/$(workspace)/requests/$(id);
    }
    function isMember(workspace) {
      return request.auth != null && exists(memberPath(workspace))
        && get(memberPath(workspace)).data.active == true
        && get(memberPath(workspace)).data.role in ['requester', 'poster'];
    }
    // Profil anggota dibaca sekali per evaluasi lalu diteruskan sebagai argumen, dan jenis
    // transisi dihitung sekali. Tanpa ini, validasi trail v3.1 melewati batas 1000 ekspresi rules.
    function memberOf(workspace) { return get(memberPath(workspace)).data; }
    function activeMember(member) {
      return member.active == true && member.role in ['requester', 'poster'];
    }
    function nonemptyName(value) { return value is string && value.size() > 0 && value.size() <= 80; }
    function identity(data) { return data.operation + '_' + data.entity + '_' + data.fiscalYear + '_' + data.documentNumber; }
    function canEdit(member, data) {
      return data.status == 'pending' && data.archived == false
        && (data.createdByUid == request.auth.uid || member.role == 'poster');
    }
    function canRemove(member, data) {
      return member.role == 'poster'
        || (data.createdByUid == request.auth.uid && data.status == 'pending' && data.archived == false);
    }
    function canRecover(member, data) {
      return member.role == 'poster' || (data.createdByUid == request.auth.uid
        && data.get('previousStatus', '') == 'pending' && data.archived == false);
    }
    function validEditing(data) {
      let revision = data.get('editRevision', 0);
      return revision is int && revision >= 0
        && data.get('editSourceId', '') is string && data.get('editSourceId', '').size() <= 80
        && ((revision == 0 && data.get('editedAt', null) == null
          && data.get('editedByUid', '') == '' && data.get('editedByName', '') == '')
        || (revision > 0 && data.get('editedAt', null) is timestamp && data.editedAt <= request.time
          && data.get('editedByUid', '') is string && data.editedByUid.size() > 0 && nonemptyName(data.get('editedByName', ''))));
    }
    function validDeletion(data) {
      return (data.status != 'deleted' && data.get('previousStatus', '') == ''
        && data.get('deletedAt', null) == null && data.get('deletedByUid', '') == '' && data.get('deletedByName', '') == ''
        && data.get('deleteKind', '') == '' && data.get('replacementId', '') == '')
      || (data.status == 'deleted' && data.get('previousStatus', '') in ['pending', 'done']
        && data.get('deletedAt', null) is timestamp && data.deletedAt <= request.time
        && data.get('deletedByUid', '') is string && data.deletedByUid.size() > 0 && nonemptyName(data.get('deletedByName', ''))
        && ((data.get('deleteKind', '') == 'user' && data.get('replacementId', '') == '')
          || (data.get('deleteKind', '') == 'edit' && data.get('replacementId', '') is string
            && data.replacementId.matches('^(reverse|cancel)_(AIO|ODI)_20[0-9]{2}_[0-9]{10}$'))));
    }
    // Jejak aktivitas v3.1: setiap tulis wajib menambah tepat satu entri `trail.e<N>`
    // dengan waktu server, UID, dan nama akun sendiri. Entri lama tidak boleh diubah/dihapus.
    function trailAppended(member, before, after, action) {
      let sequence = before.get('trailCount', 0) + 1;
      let key = 'e' + string(sequence);
      let change = after.get('trail', {}).diff(before.get('trail', {}));
      let entry = after.get('trail', {}).get(key, {});
      return after.get('trailCount', 0) == sequence
        && change.affectedKeys() == [key].toSet() && change.addedKeys() == [key].toSet()
        && entry.keys().hasAll(['a', 'at', 'uid', 'name']) && entry.keys().hasOnly(['a', 'at', 'uid', 'name', 'info'])
        && entry.a == action && entry.at == request.time && entry.uid == request.auth.uid
        && entry.name == member.displayName && entry.get('info', '') is string && entry.get('info', '').size() <= 300;
    }
    function validRecord(data, id) {
      let effectiveStatus = data.status == 'deleted' ? data.get('previousStatus', '') : data.status;
      return data.keys().hasAll([
        'operation', 'entity', 'fiscalYear', 'documentNumber', 'requester', 'requestDate', 'note',
        'status', 'archived', 'createdAt', 'createdByUid', 'createdByName', 'updatedAt', 'updatedByUid', 'updatedByName',
        'completedAt', 'completedByUid', 'completedByName', 'archivedAt', 'archivedByUid', 'archivedByName'
      ]) && data.keys().hasOnly([
        'operation', 'entity', 'fiscalYear', 'documentNumber', 'requester', 'requestDate', 'note',
        'status', 'archived', 'createdAt', 'createdByUid', 'createdByName', 'updatedAt', 'updatedByUid', 'updatedByName',
        'completedAt', 'completedByUid', 'completedByName', 'archivedAt', 'archivedByUid', 'archivedByName',
        'editedAt', 'editedByUid', 'editedByName', 'editRevision', 'editSourceId',
        'previousStatus', 'deletedAt', 'deletedByUid', 'deletedByName', 'deleteKind', 'replacementId',
        'trail', 'trailCount'
      ])
        && data.get('trail', {}) is map && data.get('trailCount', 0) is int
        && data.operation in ['reverse', 'cancel'] && data.entity in ['AIO', 'ODI']
        && data.fiscalYear is string && data.fiscalYear.matches('^20[0-9]{2}$')
        && data.documentNumber is string && data.documentNumber.matches('^[0-9]{10}$') && id == identity(data)
        && nonemptyName(data.requester) && data.requestDate is string && data.requestDate.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 500 && data.status in ['pending', 'done', 'deleted'] && data.archived is bool
        && data.createdAt is timestamp && data.createdAt <= request.time && data.updatedAt is timestamp
        && data.createdByUid is string && data.createdByUid.size() > 0 && nonemptyName(data.createdByName)
        && data.updatedByUid is string && data.updatedByUid.size() > 0 && nonemptyName(data.updatedByName)
        && validEditing(data) && validDeletion(data)
        && ((effectiveStatus == 'pending' && data.archived == false && data.completedAt == null && data.completedByUid == '' && data.completedByName == '')
          || (effectiveStatus == 'done' && data.completedAt is timestamp && data.completedAt <= request.time
            && data.completedByUid is string && data.completedByUid.size() > 0 && nonemptyName(data.completedByName)))
        && ((data.archived == false && data.archivedAt == null && data.archivedByUid == '' && data.archivedByName == '')
          || (data.archived == true && effectiveStatus == 'done' && data.archivedAt is timestamp && data.archivedAt <= request.time
            && data.archivedByUid is string && data.archivedByUid.size() > 0 && nonemptyName(data.archivedByName)));
    }
    function stampedBy(member, data) {
      return data.updatedAt == request.time && data.updatedByUid == request.auth.uid && data.updatedByName == member.displayName;
    }
    function editedNow(member, before, after) {
      return after.get('editRevision', 0) == before.get('editRevision', 0) + 1
        && after.editedAt == request.time && after.editedByUid == request.auth.uid && after.editedByName == member.displayName;
    }
    function normalCreate(member, data) {
      return data.status == 'pending' && data.archived == false && data.createdAt == request.time
        && data.createdByUid == request.auth.uid && data.createdByName == member.displayName
        && data.requester == member.displayName && data.get('editRevision', 0) == 0 && data.get('editSourceId', '') == ''
        && trailAppended(member, {}, data, 'create');
    }
    function correctedCreate(workspace, member, id, data) {
      let sourceId = data.get('editSourceId', '');
      let before = get(requestPath(workspace, sourceId)).data;
      let after = getAfter(requestPath(workspace, sourceId)).data;
      return sourceId != '' && sourceId != id && canEdit(member, before)
        && data.createdAt == before.createdAt && data.createdByUid == before.createdByUid
        && data.createdByName == before.createdByName && data.requester == before.requester
        && data.status == 'pending' && data.archived == false && editedNow(member, before, data)
        && trailAppended(member, before, data, 'edit')
        && after.status == 'deleted' && after.get('deleteKind', '') == 'edit' && after.get('replacementId', '') == id
        && after.get('deletedAt', null) == request.time && after.get('deletedByUid', '') == request.auth.uid;
    }
    function createAllowed(workspace, id, member, data) {
      return activeMember(member) && stampedBy(member, data)
        && (normalCreate(member, data) || correctedCreate(workspace, member, id, data))
        && validRecord(data, id);
    }
    // Jenis transisi ditentukan sekali dari data sebelum/sesudah; entri trail harus sama.
    function transitionOf(before, after) {
      return before.status != 'deleted' && after.status == 'deleted' ? 'delete'
        : before.status == 'deleted' ? 'undelete'
        : before.status == after.status && before.archived == after.archived ? 'edit'
        : before.archived != after.archived ? (after.archived == true ? 'archive' : 'restore')
        : after.status == 'done' ? 'done' : 'reopen';
    }
    function processUpdate(member, before, after) {
      return member.role == 'poster' && after.diff(before).affectedKeys().hasOnly([
        'status', 'archived', 'completedAt', 'completedByUid', 'completedByName',
        'archivedAt', 'archivedByUid', 'archivedByName', 'updatedAt', 'updatedByUid', 'updatedByName', 'trail', 'trailCount'
      ]) && (
        (before.status == 'pending' && before.archived == false && after.status == 'done' && after.archived == false
          && after.completedAt == request.time && after.completedByUid == request.auth.uid && after.completedByName == member.displayName)
        || (before.status == 'done' && before.archived == false && after.status == 'pending' && after.archived == false)
        || (before.status == 'done' && before.archived == false && after.status == 'done' && after.archived == true
          && after.completedAt == before.completedAt && after.completedByUid == before.completedByUid && after.completedByName == before.completedByName
          && after.archivedAt == request.time && after.archivedByUid == request.auth.uid && after.archivedByName == member.displayName)
        || (before.status == 'done' && before.archived == true && after.status == 'done' && after.archived == false
          && after.completedAt == before.completedAt && after.completedByUid == before.completedByUid && after.completedByName == before.completedByName)
      );
    }
    function editUpdate(member, before, after) {
      return canEdit(member, before) && after.diff(before).affectedKeys().hasOnly([
        'requestDate', 'note', 'updatedAt', 'updatedByUid', 'updatedByName', 'editedAt', 'editedByUid', 'editedByName', 'editRevision',
        'trail', 'trailCount'
      ]) && editedNow(member, before, after);
    }
    function correctionLink(workspace, member, id, before, after) {
      let targetId = after.get('replacementId', '');
      return canEdit(member, before) && targetId != '' && targetId != id && !exists(requestPath(workspace, targetId))
        && getAfter(requestPath(workspace, targetId)).data.get('editSourceId', '') == id
        && getAfter(requestPath(workspace, targetId)).data.createdByUid == before.createdByUid;
    }
    function removeUpdate(workspace, member, id, before, after) {
      return canRemove(member, before)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'previousStatus', 'deletedAt', 'deletedByUid', 'deletedByName', 'deleteKind', 'replacementId', 'updatedAt', 'updatedByUid', 'updatedByName',
          'trail', 'trailCount'
        ]) && after.previousStatus == before.status
        && after.deletedAt == request.time && after.deletedByUid == request.auth.uid && after.deletedByName == member.displayName
        && ((after.deleteKind == 'user' && after.get('replacementId', '') == '')
          || (after.deleteKind == 'edit' && correctionLink(workspace, member, id, before, after)));
    }
    function recoverUpdate(member, before, after) {
      return canRecover(member, before)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'previousStatus', 'deletedAt', 'deletedByUid', 'deletedByName', 'deleteKind', 'replacementId', 'updatedAt', 'updatedByUid', 'updatedByName',
          'trail', 'trailCount'
        ]) && after.status == before.previousStatus;
    }
    function updateAllowed(workspace, id, member, before, after) {
      let action = transitionOf(before, after);
      return activeMember(member) && stampedBy(member, after)
        && trailAppended(member, before, after, action)
        && (action == 'delete' ? removeUpdate(workspace, member, id, before, after)
          : action == 'undelete' ? recoverUpdate(member, before, after)
          : action == 'edit' ? editUpdate(member, before, after)
          : processUpdate(member, before, after))
        && validRecord(after, id);
    }
    match /workspaces/{workspace}/members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /workspaces/{workspace}/requests/{id} {
      allow read: if isMember(workspace);
      allow create: if request.auth != null && createAllowed(workspace, id, memberOf(workspace), request.resource.data);
      allow update: if request.auth != null && updateAllowed(workspace, id, memberOf(workspace), resource.data, request.resource.data);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
